### 3.3 新建完整场景加载脚本

用编辑器新建：

```text
/home/hank/piper_ws/src/piper_ros/src/piper_moveit/moveit_ctrl/scripts/load_bottle_table_scene.py
```

把下面**完整代码**放进去。本脚本只调用 Planning Scene 服务添加碰撞对象，
不会向机械臂/夹爪发送运动命令，也不会自动清地图或修改允许碰撞矩阵。

```python
#!/usr/bin/python3
# -*- coding: utf-8 -*-
import math
import sys
import time

import rospy
from geometry_msgs.msg import Pose
from moveit_msgs.msg import CollisionObject, PlanningScene, PlanningSceneComponents
from moveit_msgs.srv import (
    ApplyPlanningScene, GetPlanningScene, GetPlanningSceneRequest,
)
from shape_msgs.msg import SolidPrimitive


def number(value, label):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ValueError("%s 必须填写实测数字，当前为 %r" % (label, value))
    value = float(value)
    if not math.isfinite(value):
        raise ValueError(label + " 必须是有限数值")
    return value


def vector(value, count, label):
    if not isinstance(value, list) or len(value) != count:
        raise ValueError("%s 必须包含%d个数字" % (label, count))
    return [number(v, "%s[%d]" % (label, i)) for i, v in enumerate(value)]


def make_box(name, center, size, yaw_deg):
    if any(length <= 0 for length in size):
        raise ValueError(name + " 的三个尺寸必须大于0")
    obj = CollisionObject()
    obj.header.frame_id = "base_link"
    obj.id = name
    obj.operation = CollisionObject.ADD
    # 本机 CollisionObject 有整体pose，形状位姿相对于这个pose。
    obj.pose.orientation.w = 1.0
    primitive = SolidPrimitive()
    primitive.type = SolidPrimitive.BOX
    primitive.dimensions = size  # [X方向尺寸, Y方向尺寸, Z方向尺寸]
    pose = Pose()
    pose.position.x, pose.position.y, pose.position.z = center
    half_angle = math.radians(yaw_deg) / 2.0
    pose.orientation.z = math.sin(half_angle)
    pose.orientation.w = math.cos(half_angle)
    obj.primitives = [primitive]
    obj.primitive_poses = [pose]
    return obj


def build_objects(config):
    if not isinstance(config, dict) or config.get("frame_id") != "base_link":
        raise ValueError("配置必须是字典，frame_id必须为base_link")
    table = config["table"]
    xy = vector(table["center_xy"], 2, "table.center_xy")
    size_xy = vector(table["size_xy"], 2, "table.size_xy")
    top = number(table["z_top"], "table.z_top")
    bottom = number(table["z_bottom"], "table.z_bottom")
    margin_xy = number(table["margin_xy"], "table.margin_xy")
    margin_z = number(table["margin_z"], "table.margin_z")
    yaw = number(table["yaw_deg"], "table.yaw_deg")
    if top <= bottom or min(size_xy) <= 0 or min(margin_xy, margin_z) < 0:
        raise ValueError("桌面上下高度、边长或余量无效")
    objects = [make_box(
        "table", [xy[0], xy[1], (top + bottom) / 2.0],
        [size_xy[0] + 2 * margin_xy, size_xy[1] + 2 * margin_xy,
         top - bottom + 2 * margin_z], yaw)]
    names = {"table"}
    fixed_boxes = config.get("fixed_boxes", [])
    if not isinstance(fixed_boxes, list):
        raise ValueError("fixed_boxes必须是列表")
    for item in fixed_boxes:
        name = item["name"]
        if (not isinstance(name, str) or not name.strip()
                or name in names or name == "target_bottle"):
            raise ValueError("固定障碍名称为空、重复或使用了瓶子名称")
        objects.append(make_box(
            name, vector(item["center"], 3, name + ".center"),
            vector(item["size"], 3, name + ".size"),
            number(item["yaw_deg"], name + ".yaw_deg")))
        names.add(name)
    return objects


def main():
    rospy.init_node("load_bottle_table_scene")
    # rosparam load命令将YAML装入这个全局命名空间。
    config = rospy.get_param("/bottle_scene")
    objects = build_objects(config)  # 全部参数通过检查后才提交。
    for service in ("/apply_planning_scene", "/get_planning_scene"):
        rospy.wait_for_service(service, timeout=10.0)
    apply_scene = rospy.ServiceProxy("/apply_planning_scene", ApplyPlanningScene)
    get_scene = rospy.ServiceProxy("/get_planning_scene", GetPlanningScene)
    diff = PlanningScene()
    diff.is_diff = True
    diff.robot_state.is_diff = True
    diff.world.collision_objects = objects
    if not apply_scene(diff).success:
        raise RuntimeError("MoveIt拒绝场景更新")

    request = GetPlanningSceneRequest()
    request.components.components = (
        PlanningSceneComponents.WORLD_OBJECT_GEOMETRY |
        PlanningSceneComponents.OCTOMAP)
    deadline = time.monotonic() + 5.0
    while not rospy.is_shutdown() and time.monotonic() < deadline:
        response = get_scene(request).scene
        actual = {obj.id: obj for obj in response.world.collision_objects}
        if all(obj.id in actual for obj in objects):
            for expected in objects:
                stored = actual[expected.id]
                if len(stored.primitives) != 1:
                    raise RuntimeError(expected.id + " 的场景几何不是预期单box")
                if stored.primitives[0].type != SolidPrimitive.BOX:
                    raise RuntimeError(expected.id + " 的场景几何类型错误")
                dims = stored.primitives[0].dimensions
                wanted = expected.primitives[0].dimensions
                if len(dims) != 3 or any(abs(a - b) > 1e-6
                                         for a, b in zip(dims, wanted)):
                    raise RuntimeError(expected.id + " 的场景尺寸与配置不符")
                rospy.loginfo("已加载 %s，尺寸(m)=%s，输入中心(base_link)=%s",
                              expected.id, list(dims),
                              expected.primitive_poses[0].position)
            if response.world.octomap.octomap.data:
                rospy.logwarn("旧OctoMap仍非空：模型已加载，按第3.5节处理后再抓取")
            rospy.loginfo("加载完成；在RViz核对位置/姿态。没有发送运动命令。")
            return 0
        rospy.sleep(0.05)
    raise RuntimeError("场景同步超时，禁止开始抓取")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyError, TypeError, ValueError, RuntimeError, rospy.ROSException) as error:
        rospy.logerr("桌面模型加载失败: %s", error)
        sys.exit(1)
```

`CollisionObject.ADD` 使用同名ID会更新这个对象，所以桌面测量修正后可以重跑。
本脚本不会删除其他对象；从 YAML 删除一个旧障碍条目也不会自动把它从场景移除。
如果确需删除，先确认真实障碍已消失，再针对那个确切ID调用移除，不能清空整个场景。

