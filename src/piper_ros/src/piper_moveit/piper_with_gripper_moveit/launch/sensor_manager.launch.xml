<launch>

  <!-- This file makes it easy to include the settings for sensor managers -->

  <!-- Params for 3D sensors config -->
  <rosparam command="load" file="$(find piper_with_gripper_moveit)/config/sensors_3d.yaml" />

  <!-- Params for the octomap monitor -->
  <!-- MoveIt's robot model root/planning frame. It is connected to base_link
       by the identity fixed joint base_to_dummy. -->
  <param name="octomap_frame" type="string" value="dummy_link" />
  <param name="octomap_resolution" type="double" value="0.02" />
  <param name="max_range" type="double" value="2.0" />

  <!-- Load the robot specific sensor manager; this sets the moveit_sensor_manager ROS parameter -->
  <arg name="moveit_sensor_manager" default="piper_description" />
  <include file="$(dirname)/$(arg moveit_sensor_manager)_moveit_sensor_manager.launch.xml" />

</launch>
